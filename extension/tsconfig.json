{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome", "wxt/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@keytap/popup": ["../src/components/keytap/popup/index.ts"],
      "@keytap/popup/*": ["../src/components/keytap/popup/*"],
      "@keytap/lib": ["../src/components/keytap/lib/index.ts"],
      "@keytap/lib/*": ["../src/components/keytap/lib/*"],
      "@keytap/protocol": ["../packages/protocol/messages.ts"],
      "~/*": ["./*"]
    },
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "entrypoints/**/*",
    "services/**/*",
    "schemas/**/*",
    "tests/**/*",
    "wxt.config.ts",
    "../src/components/keytap/**/*",
    "../packages/protocol/**/*"
  ],
  "exclude": ["node_modules", ".output", "dist"]
}
